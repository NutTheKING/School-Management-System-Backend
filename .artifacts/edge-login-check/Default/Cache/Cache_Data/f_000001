/* School-logo watermark only on Class Schedule / Teaching Schedule documents.
   Other Academics pages intentionally have no watermark. */
.schedule-sheet,
.teaching-print-sheet{
  position:relative;
  isolation:isolate;
  background:#fff;
}
.schedule-sheet::before,
.teaching-print-sheet::before{
  content:"";
  position:absolute;
  pointer-events:none;
  z-index:0;
  left:50%;
  top:50%;
  width:min(34%,320px);
  aspect-ratio:1/1;
  transform:translate(-50%,-50%);
  background-image:var(--academics-watermark-image);
  background-repeat:no-repeat;
  background-position:center;
  background-size:contain;
  opacity:.12;
  filter:saturate(.9);
}
