/* User-selectable light themes */
html[data-theme="blue"]{--theme-primary:#1f5be0;--theme-primary-dark:#1748b8;--theme-soft:#eaf2ff;--theme-border:#c9daf5;--theme-text:#173d69}
html[data-theme="green"]{--theme-primary:#15945f;--theme-primary-dark:#0f7449;--theme-soft:#e9f8f1;--theme-border:#bfe4d2;--theme-text:#174f3b}
html[data-theme="purple"]{--theme-primary:#7651c9;--theme-primary-dark:#5c3ba8;--theme-soft:#f1ecfc;--theme-border:#d9cdf3;--theme-text:#493879}
html[data-theme="orange"]{--theme-primary:#e07824;--theme-primary-dark:#bd5d15;--theme-soft:#fff1e5;--theme-border:#f2d1b5;--theme-text:#754319}
html[data-theme]{--blue:var(--theme-primary);--sr-blue:var(--theme-primary);--ed-blue:var(--theme-primary);--teal:var(--theme-primary);--nav:var(--theme-primary);--nav-2:var(--theme-primary-dark)}
html[data-theme] body.day-time,html[data-theme] body.night-time{color:var(--theme-text)!important}
html[data-theme] .nav-item.active,html[data-theme] .nav-child.active{background:var(--theme-primary)!important;color:#fff!important}
html[data-theme] .nav-item:hover,html[data-theme] .nav-child:hover{background:var(--theme-soft)!important;color:var(--theme-primary-dark)!important}
html[data-theme] .btn.primary,html[data-theme] .system-pagination button.active{background:var(--theme-primary)!important;border-color:var(--theme-primary)!important;color:#fff!important}
html[data-theme] body .content table th{background:var(--theme-soft)!important;color:var(--theme-text)!important;border-color:var(--theme-border)!important}
html[data-theme] body .content table tbody tr:nth-child(odd) td{background:color-mix(in srgb,var(--theme-soft) 42%,#fff)!important;color:var(--theme-text)!important}
html[data-theme] body .content input:focus,html[data-theme] body .content select:focus,html[data-theme] body .content textarea:focus{border-color:var(--theme-primary)!important;box-shadow:0 0 0 3px color-mix(in srgb,var(--theme-primary) 13%,transparent)!important;outline:0}
html[data-theme] .crumb span,html[data-theme] .crumb strong,html[data-theme] .profile-copy b{color:var(--theme-text)!important}
html[data-theme] .notification-btn{color:var(--theme-primary)!important}
.theme-list{position:absolute;right:calc(100% + 8px);top:106px;width:160px;padding:5px;background:#fff;border:1px solid #dce8f5;border-radius:10px;box-shadow:0 12px 28px rgba(24,73,126,.16);z-index:90}
.theme-list[hidden]{display:none}
.theme-list button{display:flex;align-items:center;gap:9px;width:100%;min-height:38px;padding:0 10px;border:0;border-radius:7px;background:#fff;color:#173d69;font:inherit;font-size:12px;font-weight:700;cursor:pointer}
.theme-list button:hover,.theme-list button.active{background:var(--theme-soft);color:var(--theme-primary-dark)}
.theme-dot{width:13px;height:13px;border-radius:50%;box-shadow:0 0 0 2px #fff,0 0 0 3px #d5dfeb}.theme-dot.blue{background:#1f5be0}.theme-dot.green{background:#15945f}.theme-dot.purple{background:#7651c9}.theme-dot.orange{background:#e07824}
